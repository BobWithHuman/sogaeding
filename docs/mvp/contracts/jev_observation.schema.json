{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:with-human:jev-observation:2",
  "description": "Pinned Jev raw response subset (jev-response-2). Runtime keeps exact coverage, finite/range, argmax and sum checks; confidence uses a documented bounded display-compatibility check and policy min(provider,unrounded computed). Nullable usage is UNKNOWN and never refunds reservations. Not authority or execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "answers", "usage"],
  "properties": {
    "model": {"const": "jev-1.13.0"},
    "answers": {
      "type": "object", "minProperties": 1, "maxProperties": 24,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["type", "noul"],
            "properties": {"type": {"const": "noul"}, "noul": {"type": "number", "minimum": 0, "maximum": 1}}
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["type", "choice", "probabilities", "confidence"],
            "properties": {
              "type": {"const": "choice"}, "choice": {"type": "string"},
              "probabilities": {"type": "object", "minProperties": 2, "maxProperties": 16,
                "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"},
                "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        ]
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 64000},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000}
      }
    }
  }
}
