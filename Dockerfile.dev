ARG PYTHON_IMAGE=python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
FROM ${PYTHON_IMAGE} AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1
RUN groupadd --gid 10001 app && useradd --uid 10001 --gid app --create-home app \
    && mkdir /data && chown app:app /data
WORKDIR /workspace

FROM base AS resolver
RUN python -m pip install --no-cache-dir pip-tools==7.5.2
ENTRYPOINT ["pip-compile"]

FROM base AS dev
COPY requirements-dev.lock /opt/requirements-dev.lock
RUN python -m pip install --require-hashes --no-cache-dir -r /opt/requirements-dev.lock
USER 10001:10001
CMD ["python", "-c", "import time; time.sleep(86400)"]
