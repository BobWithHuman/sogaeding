runtime/

# Host-generated caches and credentials are never repository source.
/%SystemDrive%/
*.token
*.api-key
*.pfx
*.p12
*.zip
*.tar
*.tar.gz
node_modules/

# A literal "~" folder created by an unexpanded path is never source.
/~/

