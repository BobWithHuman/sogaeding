# Populate credentials only in an ignored local environment file or process environment.
# Do not bake this file or actual keys into an image.
HUMAN_USER_TOKEN=
GATEWAY_SERVICE_TOKEN=

# Codex CLI LIVE runner consumes these; Control/Gateway containers do not need an API key.
OPENAI_API_KEY=
WITH_HUMAN_CODEX_MODEL=
WITH_HUMAN_CONTROL_URL=https://127.0.0.1:8000
WITH_HUMAN_MCP_URL=https://127.0.0.1:8001/mcp
CODEX_CA_CERTIFICATE=
